{
  "name": "smart-kitchen",
  "private": true,
  "version": "0.0.1",
  "description": "Smart Kitchen - A full-stack recipe management platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@smart-kitchen/web",
    "dev:gateway": "turbo run dev --filter=@smart-kitchen/gateway",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@smart-kitchen/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.2"
  }
}
